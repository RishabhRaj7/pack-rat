# Copy this file to .env.local and replace the values from Firebase Console:
# Project settings > Your apps > Web app configuration.
# This app uses Cloud Firestore and Cloud Storage (not Realtime Database).
# Without these values the app runs fully offline-first using IndexedDB only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: live flight status via AeroDataBox on RapidAPI. Without it, status is estimated from the schedule.
VITE_AERODATABOX_KEY=
